  "storage": "All CPU state is built from cross-coupled gates, master/slave latches and gate-selected register banks; no built-in flip-flops or memory.",
  "primitive_counts_expanded": {
    "#Base/Text": 164,
    "#Gates/AND Gate": 1849,
